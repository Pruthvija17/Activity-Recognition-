{
  "project": "SIH26174 - BAS Activity Intelligence",
  "version": "2.0.0",
  "detector": {
    "weights": "yolo11n-pose.pt",
    "confidence_threshold": 0.25,
    "keypoint_visibility": 0.5,
    "tracker": "bytetrack.yaml"
  },
  "sampling": {
    "sample_fps": 8.0
  },
  "tracking": {
    "min_track_seconds": 1.0
  },
  "activity_engine": {
    "type": "rule-based",
    "feature_window_seconds": 1.0,
    "softmax_temperature": 6.0,
    "unknown_min_probability": 0.40,
    "entropy_threshold_bits": {
      "Low": 2.5,
      "Medium": 1.75,
      "High": 1.0
    }
  },
  "event_segmentation": {
    "smoothing_window_seconds": 0.6,
    "hysteresis_seconds": 0.4,
    "min_event_duration_seconds": 1.0,
    "max_gap_seconds": 1.0,
    "pick_place_context_seconds": 2.0
  }
}
